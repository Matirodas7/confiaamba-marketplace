              <Button asChild size="default" variant="secondary" className="font-bold rounded-xl h-11">
                <Link to="/auth">Registrarme como profesional</Link>
              </Button>
            </div>
          </div>
        </section>
      </main>

      <SiteFooter />
    </div>
  );
}
